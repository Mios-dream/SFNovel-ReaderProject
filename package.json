    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.5",
    "lucide-vue-next": "^1.0.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
